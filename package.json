{
  "name": "@local/online-model-discovery",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "description": "Online-first model discovery, per-model reasoning-effort editing, and catalog-derived compat for pi-ai providers.",
  "scripts": { "test": "node test/catalog-compat.test.mjs" },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-settings-models"]
    }
  }
}
